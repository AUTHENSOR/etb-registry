{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.authensor.com/etb/schema/etb-database-specific/1",
  "title": "ETB registry: database_specific.etb block",
  "type": "object",
  "required": [
    "etb"
  ],
  "properties": {
    "etb": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "classes",
        "family",
        "target",
        "attack",
        "hardening",
        "disclosure",
        "cross_references"
      ],
      "properties": {
        "schema": {
          "const": "etb-registry/1"
        },
        "classes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^ETB-(0[1-9]|[1-9][0-9])$"
          }
        },
        "family": {
          "enum": [
            "verdict-path",
            "aggregation",
            "detection-coverage",
            "sandbox-environment"
          ]
        },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "name",
            "repo"
          ],
          "properties": {
            "kind": {
              "enum": [
                "grader",
                "judge",
                "monitor",
                "harness",
                "benchmark",
                "metric",
                "detector",
                "runner",
                "other"
              ]
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "repo": {
              "type": "string",
              "format": "uri"
            },
            "components": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "affected_component_versions": {
              "type": "string"
            }
          }
        },
        "attack": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "description",
            "demonstrated"
          ],
          "properties": {
            "description": {
              "type": "string",
              "minLength": 20
            },
            "preconditions": {
              "type": "string"
            },
            "demonstrated": {
              "type": "boolean"
            },
            "poc_public": {
              "type": "boolean"
            },
            "poc_pointer": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "hardening": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "fix"
          ],
          "properties": {
            "fix": {
              "type": "string",
              "minLength": 10
            },
            "pattern": {
              "type": "string"
            },
            "residual_risk": {
              "type": "string"
            }
          }
        },
        "disclosure": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tier",
            "status",
            "channel",
            "reported"
          ],
          "properties": {
            "tier": {
              "enum": [
                1,
                2
              ]
            },
            "tier_reason": {
              "type": "string"
            },
            "status": {
              "enum": [
                "draft",
                "notified",
                "acknowledged",
                "fixed",
                "published",
                "withdrawn"
              ]
            },
            "channel": {
              "type": "array",
              "items": {
                "enum": [
                  "github-issue",
                  "github-pr",
                  "security-advisory",
                  "email",
                  "vendor-program",
                  "other"
                ]
              }
            },
            "reported": {
              "type": [
                "string",
                "null"
              ],
              "format": "date",
              "description": "Date the maintainer received the report; null only while status is draft"
            },
            "acknowledged": {
              "type": [
                "string",
                "null"
              ],
              "format": "date"
            },
            "fixed": {
              "type": [
                "string",
                "null"
              ],
              "format": "date"
            },
            "released": {
              "type": [
                "string",
                "null"
              ]
            },
            "registry_published": {
              "type": [
                "string",
                "null"
              ],
              "format": "date"
            },
            "notes": {
              "type": "string"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "status": {
                    "not": {
                      "const": "draft"
                    }
                  }
                }
              },
              "then": {
                "properties": {
                  "reported": {
                    "type": "string"
                  }
                }
              }
            }
          ]
        },
        "cross_references": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cwe": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^CWE-[0-9]+$"
              }
            },
            "atlas": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "version": {
                  "type": "string"
                },
                "tactics": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^AML\\.TA[0-9]{4}$"
                  }
                },
                "techniques": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^AML\\.T[0-9]{4}(\\.[0-9]{3})?$"
                  }
                },
                "fit": {
                  "enum": [
                    "exact",
                    "best-fit",
                    "none"
                  ]
                },
                "case_study": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            },
            "owasp_ai_exchange": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "section": {
                  "type": "string"
                },
                "mechanism": {
                  "type": "string"
                },
                "url": {
                  "type": "string",
                  "format": "uri"
                },
                "status": {
                  "type": "string"
                }
              }
            },
            "owasp_llm_top10_2025": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^LLM(0[1-9]|10)$"
              }
            },
            "nist_caisi_category": {
              "enum": [
                "grader-gaming",
                "solution-contamination",
                null
              ]
            }
          }
        },
        "harness": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "probes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "attacker_strategies": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "url"
            ],
            "additionalProperties": false,
            "properties": {
              "url": {
                "type": "string",
                "format": "uri"
              },
              "note": {
                "type": "string"
              }
            }
          }
        },
        "severity_self": {
          "enum": [
            "low",
            "medium",
            "high",
            "critical",
            null
          ]
        },
        "unverified": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
